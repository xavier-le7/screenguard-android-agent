    <string name="app_name">ScreenGuard</string>
    <string name="guard_accessibility_description">ScreenGuard applies the child profile’s time limits and schedules. It detects only the foreground app and does not record screen content. Home, calls and emergencies remain accessible. Sensitive settings can be protected by a parent PIN.</string>
    <string name="device_admin_explanation">ScreenGuard uses device administrator access only to add an extra step before uninstalling. It does not request wiping, locking or changing the Android password.</string>
